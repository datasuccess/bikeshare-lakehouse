# .env.example — copy to .env and fill in. NEVER commit the real .env (git-ignored).
# Purpose: document every environment variable the platform reads. Local defaults are $0 / no-secret.

# ── Object store (S3 API) ───────────────────────────────
# Local = MinIO. Cloud (later) = AWS S3 — only these three lines change.
AWS_ENDPOINT_URL=http://localhost:9000     # MinIO locally; unset/AWS endpoint in cloud
AWS_ACCESS_KEY_ID=minioadmin               # MinIO default (local only)
AWS_SECRET_ACCESS_KEY=minioadmin           # MinIO default (local only)
AWS_REGION=us-east-1
LAKE_BUCKET=bikeshare-lake                 # bronze/ silver/ gold/ prefixes live here
CATALOG_URI=http://localhost:8181          # Iceberg REST catalog (Phase 2)

# ── Sources: Capital Bikeshare / dca-cabi (public, no key) ──
GBFS_DISCOVERY_URL=https://gbfs.capitalbikeshare.com/gbfs/gbfs.json
SYSTEM_ID=dca-cabi
TRIPS_BASE_URL=https://s3.amazonaws.com/capitalbikeshare-data

# ── dbt ─────────────────────────────────────────────────
DBT_TARGET=duckdb                          # local default; snowflake|bigquery|redshift in cloud
DUCKDB_PATH=dev.duckdb

# ── Orchestration (Airflow, local) ──────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# ── Alerts (optional, Phase 8) ──────────────────────────
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
