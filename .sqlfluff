# .sqlfluff — SQL linter config for the dbt models (activates in Phases 3-4).
# Why: consistent, reviewable SQL from the first model; dialect=duckdb, dbt-templated.
[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 100
exclude_rules = RF04

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt
